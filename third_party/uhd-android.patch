+        if (pos == begin || (braced && (pos == path.size() || path[pos] != '}'))) {
+            expanded += path[dollar]; pos = dollar + 1; continue;
+        }
+        const std::string key = path.substr(begin, pos - begin);
+        if (braced) ++pos;
+        if (const char* value = std::getenv(key.c_str())) expanded += value;
+    }
+    return expanded;

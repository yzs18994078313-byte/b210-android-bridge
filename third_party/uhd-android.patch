diff --git a/host/cmake/Modules/UHDBoost.cmake b/host/cmake/Modules/UHDBoost.cmake
index e8c0aae..df44d1c 100644
--- a/host/cmake/Modules/UHDBoost.cmake
+++ b/host/cmake/Modules/UHDBoost.cmake
@@ -163,7 +163,11 @@ if(NOT CMAKE_CXX_STANDARD)
 endif()
 
 # tell boost the linkage required
-set(Boost_USE_STATIC_LIBS ${ENABLE_STATIC_LIBS})
+if(ANDROID)
+    set(Boost_USE_STATIC_LIBS ON)
+else()
+    set(Boost_USE_STATIC_LIBS ${ENABLE_STATIC_LIBS})
+endif()
 # temporarily explicitly enable or disable shared libraries,
 # build-wise; this can be disabled on a case by case basis for each
 # library built.
@@ -173,7 +177,7 @@ if(BUILD_SHARED_LIBS)
 else()
     set(BUILD_SHARED_LIBS_SET FALSE)
 endif()
-if(ENABLE_STATIC_LIBS)
+if(ENABLE_STATIC_LIBS OR ANDROID)
     set(BUILD_SHARED_LIBS FALSE)
 else()
     set(BUILD_SHARED_LIBS TRUE)
diff --git a/host/lib/CMakeLists.txt b/host/lib/CMakeLists.txt
index be26c58..323d809 100644
--- a/host/lib/CMakeLists.txt
+++ b/host/lib/CMakeLists.txt
@@ -180,6 +180,10 @@ if(ENABLE_MPMD)
     list(APPEND libuhd_sources $<TARGET_OBJECTS:uhd_rpclib>)
 endif()
 add_library(uhd SHARED ${libuhd_sources})
+if(ANDROID)
+    # Bionic provides pthread functions in libc; there is no separate libpthread.
+    list(REMOVE_ITEM libuhd_libs pthread)
+endif()
 target_link_libraries(uhd ${Boost_LIBRARIES} ${libuhd_libs})
 if(ENABLE_DPDK)
     add_definitions(-DHAVE_DPDK)
